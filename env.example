# WhatsOnMyNet – settings for Docker
# Copy to .env (cp env.example .env) and adjust if needed. Without changes everything runs with the defaults.

# Ports on the host (the container uses the host network, so these are the real ports).
# HTTPS: the web interface. HTTP: only redirects to HTTPS (0 = switch off).
WOMN_HTTPS_PORT=8743
WOMN_HTTP_PORT=8780

# Program version: latest = always the newest (incl. the monthly security updates on patch day).
# To pin a version, enter e.g. 0.1.0
WOMN_VERSION=latest

# Time zone
TZ=Europe/Berlin

# Owner of the files in ./data (Synology: ID of your user/group, e.g. 1026 / 100; not 0)
PUID=1000
PGID=1000

# Optional: the address users open, e.g. https://womn.firma.local:8743
# (used for the HTTP→HTTPS redirect and added to the self-signed certificate).
# Behind a reverse proxy: its address, e.g. https://womn.firma.local
# WOMN_BASE_URL=

# Optional: your own key for stored passwords (at least 16 characters).
# Empty = generated on first start and stored in ./data/secret.key (include it in backups!).
# Only set this during setup – changing it later makes stored passwords unreadable.
WOMN_SECRET=

# Behind a reverse proxy: its address (e.g. 10.0.10.5). Only then are X-Forwarded headers trusted and the proxy
# may also talk plain HTTP to WOMN_HTTP_PORT. Same HTTPS rules as Catalytix, AssetLotse and Helfi.Space.
# WOMN_TRUST_PROXY=10.0.10.5
# HSTS header: on (default: only with an uploaded certificate or where a proxy did not redirect itself),
# off (never), preload (always, only if all subdomains speak HTTPS for good).
# WOMN_HSTS=on

# Rarely needed:
# Listen only on one address of the host (default: all):
# WOMN_BIND=192.168.10.5
# Log level (debug | info | warn | error) and sign-out after this many hours without activity:
# WOMN_LOG_LEVEL=info
# WOMN_SESSION_HOURS=12
# Your own setup code instead of a random one:
# WOMN_SETUP_TOKEN=
# Running a modified version? AGPL-3.0 requires offering your users its source code:
# WOMN_SOURCE_URL=https://git.firma.example/it/whatsonmynet
